{
  "name": "eos-rag",
  "version": "0.2.1",
  "private": true,
  "description": "Local hybrid RAG layer for engineering-os: transformers.js + SQLite (sqlite-vec + FTS5)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanya-ok/engineering-os.git",
    "directory": "rag"
  },
  "homepage": "https://tanya-ok.github.io/engineering-os/",
  "bugs": {
    "url": "https://github.com/tanya-ok/engineering-os/issues"
  },
  "type": "module",
  "bin": {
    "eos-rag": "dist/cli.js"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@huggingface/transformers": "4.3.1",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.13",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "vaults.example.json",
    "routing.example.json"
  ]
}
