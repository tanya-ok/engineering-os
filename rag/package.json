{
  "name": "eos-rag",
  "version": "0.2.1",
  "description": "Local hybrid RAG layer for engineering-os: transformers.js + SQLite (sqlite-vec + FTS5)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "eos-rag": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@huggingface/transformers": "4.2.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.7",
    "sqlite-vec": "0.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "onnxruntime-node",
      "sharp"
    ],
    "overrides": {
      "adm-zip": ">=0.6.0",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
