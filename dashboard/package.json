{
  "name": "eos-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Work-graph dashboard for engineering-os: beads issues by project, dependencies, ready queue",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanya-ok/engineering-os.git",
    "directory": "dashboard"
  },
  "homepage": "https://tanya-ok.github.io/engineering-os/",
  "bugs": {
    "url": "https://github.com/tanya-ok/engineering-os/issues"
  },
  "type": "module",
  "bin": {
    "eos-dashboard": "dist/cli.js"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "build:web": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "serve": "node dist/cli.js serve"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/d3": "7.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "d3": "7.9.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "public",
    "fixtures",
    "dashboard.example.json"
  ]
}
