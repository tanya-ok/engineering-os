{
  "comment": "Several repositories, each with its own .beads directory, in one graph. Copy to dashboard/dashboard.json or keep it outside the repo and pass --config. The project of an issue is its repository_id.",
  "ttl_seconds": 30,
  "sources": [
    {
      "source_id": "beads",
      "repository_id": "orchard-search",
      "label": "Orchard Search",
      "source": { "kind": "bd", "root": "~/code/orchard-search" }
    },
    {
      "source_id": "beads",
      "repository_id": "orchard-infra",
      "label": "Orchard Infra",
      "source": { "kind": "bd", "root": "~/code/orchard-infra" }
    }
  ],
  "projects": {
    "orchard-search": { "label": "Orchard Search", "url": "https://example.com/orchard" },
    "orchard-infra": { "label": "Orchard Infra" }
  }
}
